# Flask
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-secret
# Leave DEBUG off unless you are actively debugging locally. NEVER enable in production.
FLASK_DEBUG=false
HOST=127.0.0.1
PORT=5000

# Logging: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Where generated CSV files are written
OUTPUT_DIR=output

# Selenium / scraping
# Run Chrome without a visible window (recommended, required for servers/Docker)
HEADLESS=true
# Overall time budget for a single scrape (seconds)
SCRAPE_TIMEOUT=240
# Seconds to wait after each scroll for new videos to load
SCROLL_PAUSE=1.2
# Consecutive no-growth scrolls before we conclude we've reached the end
SCROLL_MAX_STALE=3
# Absolute safety cap on scroll iterations
SCROLL_MAX_ROUNDS=400
# Explicit-wait timeout for finding elements (seconds)
ELEMENT_TIMEOUT=20
# Optional path to a Chrome/Chromium binary (leave blank to auto-detect)
CHROME_BINARY=
# Maximum accepted length of the company name input
MAX_COMPANY_LEN=100
